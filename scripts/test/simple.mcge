once simple_deps start

    renderer_layer_manager new_layer bg1 1
    renderer_layer_manager new_layer prop1 10

    texture_manager new_texture cube 64 64 textures/demo/cube.png lazy
    texture_manager new_texture tree1 72 65 textures/demo/tree1_tileset.png lazy

once simple_deps end














scene add prefab Tree1 0 0 72 65
    entity Tree1Body 0 0 1 1
        box_renderer prop1 texture tree1 0
        box_renderer_animated 0.1
    end
end

scene add entity Forest 0 0 10 10
    forest 1 Tree1 end
end

scene add entity Cube 0 0 26 26
    box_renderer prop1 texture cube 0
    camera 100
    controller 250
    keyboard_controller
end