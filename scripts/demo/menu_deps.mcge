once menu_deps start
    catalog add renderer_layer bg1 1
    catalog add renderer_layer bg2 2
    catalog add renderer_layer prop1 10
    catalog add renderer_layer effect1 30
    catalog add renderer_layer gizmo 255
    catalog add renderer_layer ui1 101

    catalog add texture character 256 512 64 textures/demo/character.png lazy
    catalog add texture campfire 64 64 5 textures/demo/campfire.png lazy
    catalog add texture tree1 512 512 16 textures/demo/tree1.png lazy
    catalog add texture tree2 512 512 16 textures/demo/tree2.png lazy
    catalog add texture tree3 512 512 16 textures/demo/tree3.png lazy
    catalog add texture tree4 512 512 16 textures/demo/tree4.png lazy
    catalog add texture tree5 512 512 16 textures/demo/tree5.png lazy
    catalog add texture enemy1 192 192 16 textures/demo/enemy1.png lazy
    catalog add texture enemy2 192 192 16 textures/demo/enemy2.png lazy

    catalog add texture gcirc1 512 512 1 textures/core/gcirc1.png lazy
    catalog add texture gcirc2 512 512 1 textures/core/gcirc2.png lazy
    catalog add texture gcirc3 512 512 1 textures/core/gcirc3.png lazy
    catalog add texture gcirc4 512 512 1 textures/core/gcirc4.png lazy
    catalog add texture gcirc5 512 512 1 textures/core/gcirc5.png lazy
    catalog add texture gcirc6 512 512 1 textures/core/gcirc6.png lazy
once menu_deps end