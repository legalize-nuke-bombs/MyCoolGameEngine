eval scripts/demo/map_deps.mcge

scene add entity GameState 0 0 1 1
    clock 0 3600
    sky 125 125 150 255 40 40 70 255
    scene_switcher Escape scripts/demo/menu.mcge
end

scene add entity Terrain 0 0 250 250
    box_renderer bg1 color 50 60 60 255
    rigid_surface bg1 ground
end

scene add entity Lake -7 1 9 9
    box_renderer bg2 color 60 60 255 255
    rigid_surface bg2 ice
end

scene add entity Forest 0 0 250 250
    forest 5000 Tree1 Tree2 Tree3 Tree4 Tree5 Tree6 Tree7 Tree8 end
end

scene add entity Forest 0 0 250 250
    forest 500 Enemy end
end

scene add entity Campfire 4 2 2 2
    box_renderer prop1 texture campfire 0
    box_renderer_animated 2.5
    entity Light 0 0 5 5
        box_light texture gcirc1 0
        pulsator 0.99 1.01 10
    end
    entity Collider 0 -0.25 0.5 0.5
        collider ground
    end
end

scene add entity Crate1 -3 -5 1 1
    box_renderer prop1 color 170 120 70 255
    collider wood
    rigid_body 25 1 1.5
end

scene add entity Crate2 -1.8 -5 1 1
    box_renderer prop1 color 170 120 70 255
    collider wood
    rigid_body 25 1 1.5
end

scene add entity Crate3 -0.6 -5 1 1
    box_renderer prop1 color 170 120 70 255
    collider wood
    rigid_body 25 1 1.5
end

scene add entity Boulder 9 -3 1.5 1.5
    box_renderer prop1 color 120 120 120 255
    collider stone
    rigid_body 1000 1 1
end

scene add entity Ball1 -1 5 0.75 0.75
    box_renderer prop1 color 230 60 60 255
    collider rubber
    rigid_body 5 1 1
end

scene add entity Ball2 -1 7 0.75 0.75
    box_renderer prop1 color 230 60 60 255
    collider rubber
    rigid_body 5 1 1
end

scene add entity Cube 2.5 1.5 0.8 0.8
    box_renderer prop1 texture cube 0
    collider character
    rigid_body 50 10 0.2
    keyboard_rigid_controller 6.25 W S A D
    camera 33.75
    simulator 50
    player
    mana 800
    skilled printer 100 1 1000-7=?
end