

/* Deps */
once map_deps start

    catalog add renderer_layer bg1 1
    catalog add renderer_layer bg2 2
    catalog add renderer_layer prop1 10

    catalog add rigid_layer bg1 1
    catalog add rigid_layer bg2 2

    catalog add rigid_material ground 0.5 0.15
    catalog add rigid_material ice 0.075 0.55
    catalog add rigid_material rubber 0.7 0.8
    catalog add rigid_material wood 0.4 0.3
    catalog add rigid_material stone 0.6 0.05
    catalog add rigid_material character 0.3 0.075

    catalog add texture cube 64 64 1 textures/demo/cube.png lazy
    catalog add texture campfire 64 64 5 textures/demo/campfire.png lazy
    catalog add texture tree1 72 65 4 textures/demo/tree1_tileset.png lazy
    catalog add texture tree2 72 65 4 textures/demo/tree2_tileset.png lazy
    catalog add texture tree3 72 65 4 textures/demo/tree3_tileset.png lazy
    catalog add texture tree4 72 65 4 textures/demo/tree4_tileset.png lazy
    catalog add texture tree5 72 65 4 textures/demo/tree5_tileset.png lazy
    catalog add texture tree6 72 65 4 textures/demo/tree6_tileset.png lazy
    catalog add texture tree7 72 65 4 textures/demo/tree7_tileset.png lazy
    catalog add texture tree8 72 65 4 textures/demo/tree8_tileset.png lazy
    catalog add texture gcirc1 512 512 1 textures/core/gcirc1.png lazy
    catalog add texture gcirc2 512 512 1 textures/core/gcirc2.png lazy
    catalog add texture gcirc3 512 512 1 textures/core/gcirc3.png lazy
    catalog add texture gcirc4 512 512 1 textures/core/gcirc4.png lazy
    catalog add texture gcirc5 512 512 1 textures/core/gcirc5.png lazy
    catalog add texture gcirc6 512 512 1 textures/core/gcirc6.png lazy

    catalog add prefab Tree1 0 0 2.25 2
        box_renderer prop1 texture tree1 0
        box_renderer_animated 2.5
    end

    catalog add prefab Tree2 0 0 2.25 2
        box_renderer prop1 texture tree2 0
        box_renderer_animated 2.5
    end

    catalog add prefab Tree3 0 0 2.25 2
        box_renderer prop1 texture tree3 0
        box_renderer_animated 2.5
    end

    catalog add prefab Tree4 0 0 2.25 2
        box_renderer prop1 texture tree4 0
        box_renderer_animated 2.5
    end

    catalog add prefab Tree5 0 0 2.25 2
        box_renderer prop1 texture tree5 0
        box_renderer_animated 2.5
    end

    catalog add prefab Tree6 0 0 2.25 2
        box_renderer prop1 texture tree6 0
        box_renderer_animated 2.5
    end

    catalog add prefab Tree7 0 0 2.25 2
        box_renderer prop1 texture tree7 0
        box_renderer_animated 2.5
    end

    catalog add prefab Tree8 0 0 2.25 2
        box_renderer prop1 texture tree8 0
        box_renderer_animated 2.5
    end

once map_deps end








/* Scene */


scene add entity Terrain 0 0 250 250
    box_renderer bg1 color 54 78 62 255
    rigid_surface bg1 ground
end

scene add entity Lake -7 1 9 9
    box_renderer bg2 color 100 100 255 255
    rigid_surface bg2 ice
end

scene add entity GameState 0 0 1 1
    clock 36000 3600
    sky 200 200 200 255 50 50 80 255
    scene_switcher Escape scripts/demo/menu.mcge
end


/* Dense forest all around a 32 x 24 clearing */

scene add entity ForestNorth 0 68.5 250 113
    forest 4500 Tree1 Tree2 Tree3 Tree4 Tree5 Tree6 Tree7 Tree8 end
end

scene add entity ForestSouth 0 -68.5 250 113
    forest 4500 Tree1 Tree2 Tree3 Tree4 Tree5 Tree6 Tree7 Tree8 end
end

scene add entity ForestWest -70.5 0 109 24
    forest 420 Tree1 Tree2 Tree3 Tree4 Tree5 Tree6 Tree7 Tree8 end
end

scene add entity ForestEast 70.5 0 109 24
    forest 420 Tree1 Tree2 Tree3 Tree4 Tree5 Tree6 Tree7 Tree8 end
end


/* Sparse fringe along the clearing edge */

scene add entity FringeNorth 0 10 32 4
    forest 6 Tree1 Tree2 Tree3 Tree4 Tree5 Tree6 Tree7 Tree8 end
end

scene add entity FringeSouth 0 -10 32 4
    forest 6 Tree1 Tree2 Tree3 Tree4 Tree5 Tree6 Tree7 Tree8 end
end

scene add entity FringeWest -14 0 4 16
    forest 3 Tree1 Tree2 Tree3 Tree4 Tree5 Tree6 Tree7 Tree8 end
end

scene add entity FringeEast 14 0 4 16
    forest 3 Tree1 Tree2 Tree3 Tree4 Tree5 Tree6 Tree7 Tree8 end
end


/* Camp */

scene add entity Campfire 4 2 2 2
    box_renderer prop1 texture campfire 0
    box_renderer_animated 2.5
    entity Light 0 0 5 5
        box_light texture gcirc1 0
        pulsator 0.99 1.01 10
    end
    entity Collider 0 -0.25 0.5 0.5
        collider ground
    end
end

scene add entity Crate1 -3 -5 1 1
    box_renderer prop1 color 170 120 70 255
    collider wood
    rigid_body 25 1 1.5
end

scene add entity Crate2 -1.8 -5 1 1
    box_renderer prop1 color 170 120 70 255
    collider wood
    rigid_body 25 1 1.5
end

scene add entity Crate3 -0.6 -5 1 1
    box_renderer prop1 color 170 120 70 255
    collider wood
    rigid_body 25 1 1.5
end

scene add entity Boulder 9 -3 1.5 1.5
    box_renderer prop1 color 120 120 120 255
    collider stone
    rigid_body 1000 1 1
end

scene add entity Ball1 -1 5 0.75 0.75
    box_renderer prop1 color 230 60 60 255
    collider rubber
    rigid_body 5 1 1
end

scene add entity Ball2 -1 7 0.75 0.75
    box_renderer prop1 color 230 60 60 255
    collider rubber
    rigid_body 5 1 1
end

scene add entity Cube 2.5 1.5 0.8 0.8
    box_renderer prop1 texture cube 0
    collider character
    rigid_body 50 10 0.2
    keyboard_rigid_controller 6.25 W S A D
    camera 33.75
    simulator 50
end
