print DemoSceneLaunched!

renderer_layer_manager new_layer bg1 1
renderer_layer_manager new_layer prop1 10
renderer_layer_manager new_layer character1 20
renderer_layer_manager new_layer character1_2 21

texture_manager new_texture cube 64 64 ../textures/demo/cube.png lazy 1
texture_manager new_texture tree1 72 65 ../textures/demo/tree1_tileset.png lazy 1
texture_manager new_texture tree2 72 65 ../textures/demo/tree2_tileset.png lazy 1
texture_manager new_texture tree3 72 65 ../textures/demo/tree3_tileset.png lazy 1
texture_manager new_texture tree4 72 65 ../textures/demo/tree4_tileset.png lazy 1
texture_manager new_texture tree5 72 65 ../textures/demo/tree5_tileset.png lazy 1
texture_manager new_texture tree6 72 65 ../textures/demo/tree6_tileset.png lazy 1
texture_manager new_texture tree7 72 65 ../textures/demo/tree7_tileset.png lazy 1
texture_manager new_texture tree8 72 65 ../textures/demo/tree8_tileset.png lazy 1

scene new_entity Terrain
transform default 0 0 1000000 1000000
box_renderer default bg1 color 54 78 62 255
end

scene new_entity Cube
transform default 0 0 32 32
box_renderer default character1 texture cube 0
camera default
controller default 250
keyboard_controller default
end

scene new_entity CameraRig
transform default 0 0 1 1
end

scene new_entity Tree1
transform default 200 0 72 65
box_renderer default prop1 texture tree1 0
box_renderer_animated default 0.1
end

scene new_entity Tree2
transform default 300 0 72 65
box_renderer default prop1 texture tree2 0
box_renderer_animated default 0.1
end

scene new_entity Tree3
transform default 0 200 72 65
box_renderer default prop1 texture tree3 0
box_renderer_animated default 0.1
end

scene new_entity Tree4
transform default 0 300 72 65
box_renderer default prop1 texture tree4 0
box_renderer_animated default 0.1
end

scene new_entity Tree5
transform default -200 0 72 65
box_renderer default prop1 texture tree5 0
box_renderer_animated default 0.1
end

scene new_entity Tree6
transform default -100 0 72 65
box_renderer default prop1 texture tree6 0
box_renderer_animated default 0.1
end

scene new_entity Tree7
transform default 50 0 72 65
box_renderer default prop1 texture tree7 0
box_renderer_animated default 0.1
end

scene new_entity Tree8
transform default 0 50 72 65
box_renderer default prop1 texture tree8 0
box_renderer_animated default 0.1
end

scene new_entity Torch
transform default 100 300 10 10
box_renderer default prop1 color 175 175 255 255
box_light custom 0 0 10 10
end

scene new_entity Settings
transform default 0 0 1 1
renderer_settings default 1 0 0 20 100
end