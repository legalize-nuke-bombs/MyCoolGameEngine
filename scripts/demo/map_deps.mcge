eval scripts/demo/menu_deps.mcge

once map_deps start
    catalog add rigid_layer bg1 1
    catalog add rigid_layer bg2 2

    catalog add rigid_material ground 0.5 0.15
    catalog add rigid_material ice 0.075 0.55
    catalog add rigid_material rubber 0.7 0.8
    catalog add rigid_material wood 0.4 0.3
    catalog add rigid_material stone 0.6 0.05
    catalog add rigid_material character 0.3 0.075

    catalog add bt_graph enemy selector
    sequence player_is_near 50
    selector
    sequence is_scared player_run_away 4 end
    sequence player_chase 4 end
    end
    end
    end

    catalog add prefab Enemy 0 0 1 1
        entity Hitbox 0 0 0.5 0.5
            collider character
        end
        box_renderer prop1 texture enemy1 0
        box_renderer_animated 1
        rigid_body 50 10 0.2
        behaviour_agent enemy
        effects
    end

    catalog add prefab Tree1 0 0 3 3
                box_renderer prop1 texture tree1 0
                box_renderer_animated 1
    end

        catalog add prefab Tree2 0 0 3 3
                   box_renderer prop1 texture tree2 0
                   box_renderer_animated 1
       end

       catalog add prefab Tree3 0 0 3 3
                   box_renderer prop1 texture tree3 0
                   box_renderer_animated 1
       end

       catalog add prefab Tree4 0 0 3 3
                   box_renderer prop1 texture tree4 0
                   box_renderer_animated 1
       end

       catalog add prefab Tree5 0 0 3 3
                   box_renderer prop1 texture tree5 0
                   box_renderer_animated 1
       end

    catalog add prefab FearBall 0 0 1 1
        box_renderer effect1 color 150 0 150 200
        fear_ball 50 -50 1 1.25
        collider trigger
    end

once map_deps end