eval scripts/demo/menu_deps.mcge

scene add entity MenuState 0 0 1 1
    game_closer Escape
    scene_switcher Return scripts/demo/map.mcge
    renderer_settings 1 40 40 70 255
end

scene add entity Terrain 0 0 20 20
    box_renderer bg1 color 30 30 40 255
end

scene add entity PlayButton -5 4 2 0.6
    box_renderer ui1 color 255 255 255 255
end

scene add entity ExitButton -5 3 2 0.6
    box_renderer ui1 color 255 255 255 255
end

scene add entity Camera 0 0 1 1
    camera 10
end

scene add entity Campfire 4.5 -2.5 2 2
    box_renderer prop1 texture campfire 0
    box_renderer_animated 2.5
    entity Light 0 0 5 5
        box_light texture gcirc1 0
        pulsator 0.99 1.01 10
    end
end

scene add entity Character 2.5 -1.5 3 6
    box_renderer prop1 texture character 0
    box_renderer_animated 1
end