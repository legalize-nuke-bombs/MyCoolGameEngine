once 1m_campfire_deps start

    catalog add renderer_layer bg1 1
    catalog add renderer_layer prop1 10

    catalog add texture cube 64 64 textures/demo/cube.png lazy
    catalog add texture campfire 64 64 textures/demo/campfire.png lazy
    catalog add texture gcirc1 512 512 textures/core/gcirc1.png lazy
    catalog add texture gcirc2 512 512 textures/core/gcirc2.png lazy
    catalog add texture gcirc3 512 512 textures/core/gcirc3.png lazy
    catalog add texture gcirc4 512 512 textures/core/gcirc4.png lazy
    catalog add texture gcirc5 512 512 textures/core/gcirc5.png lazy
    catalog add texture gcirc6 512 512 textures/core/gcirc6.png lazy

    catalog add prefab Campfire 100 300 64 64
        box_renderer prop1 texture campfire 0
        box_renderer_animated 0.1
        entity Light 0 0 2 2
            box_light texture gcirc1 0
            pulsator 0.99 1.01 10
        end
    end

once 1m_campfire_deps end










scene add entity Terrain 0 0 100000 100000
    box_renderer bg1 color 54 78 62 255
end

scene add entity GameState 0 0 1 1
    renderer_settings 1 50 50 80 255
end

scene add entity Forest 0 0 100000 100000
    forest 1000000 Campfire end
end

scene add entity Cube 0 0 26 26
    box_renderer prop1 texture cube 0
    camera
    simulator 2000
    controller 250
    keyboard_controller W S A D
end