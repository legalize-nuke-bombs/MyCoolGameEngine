/* menu.mcge */

eval path=scripts/menu/menu_deps.mcge

entity name=MenuState components=[
    renderer_settings darkness=[40 40 70 255]
]

entity name=Terrain size=[20 20] components=[
    box_renderer layer=bg1 color=[30 30 40 255]
]

entity name=Hud components=[
    hud
] children=[
    entity name=PlayButton position=[0.125 0.925] size=[0.2 0.05] components=[
        box_renderer layer=ui1 color=[255 255 255 255]
        text_renderer layer=ui2 string=Play color=[0 0 0 255] font=font1
        clickable
        scene_switcher_on_click script=scripts/map/map.mcge
    ]
    entity name=ExitButton position=[0.125 0.85] size=[0.2 0.05] components=[
        box_renderer layer=ui1 color=[255 255 255 255]
        text_renderer layer=ui2 string=Exit color=[0 0 0 255] font=font1
        clickable
        game_closer_on_click
    ]
    entity name=DemoGame position=[0.9 0.95] size=[0.1 0.05] components=[
        text_renderer layer=ui2 string=DemoGame color=[255 255 255 255] font=font1
    ]
    entity name=MyCoolGameEngine position=[0.075 0.025] size=[0.2 0.025] components=[
        text_renderer layer=ui2 string=MyCoolGameEngine color=[255 255 255 255] font=font1
    ]
]

entity name=Camera components=[
    camera height=5
    audio_listener
    simulator distance=50
]

entity name=Campfire position=[2.5 -1.5] size=[1.5 1.5]
    components=[
        box_renderer layer=prop1 texture=[campfire1 campfire2]
        box_renderer_animated speed=1
        audio_source sound=campfire loop=1
    ]
    children=[
        entity name=Light size=[6.5 6.5] components=[
            box_light texture=light1
            pulsator lower=0.99 upper=1.01 speed=10
        ]
    ]

entity name=Nevermore position=[1.25 -1] size=[1.5 3] components=[
    box_renderer layer=prop1 texture=nevermore1
    box_renderer_animated speed=1
]
