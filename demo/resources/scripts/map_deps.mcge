eval path=scripts/menu_deps.mcge

once name=map_deps body=[
    rigid_layer name=bg1 priority=1
    rigid_layer name=bg2 priority=2

    rigid_material name=ground friction=0.5 restitution=0.15
    rigid_material name=ice friction=0.075 restitution=0.55
    rigid_material name=rubber friction=0.7 restitution=0.8
    rigid_material name=wood friction=0.4 restitution=0.3
    rigid_material name=stone friction=0.6 restitution=0.05
    rigid_material name=character friction=0.3 restitution=0.075

    collision_layer name=arrow default=overlap
    collision_rule between=[arrow arrow] response=ignore

    bt_graph name=enemy root=[
        selector nodes=[
            sequence nodes=[
                player_is_near radius=50
                selector nodes=[
                    sequence nodes=[is_scared  player_run_away speed=4]
                    sequence nodes=[player_chase speed=4]
                ]
            ]
        ]
    ]

    prefab name=EnemyDefault
        components=[
            box_renderer layer=prop1 texture=[enemy_default1 enemy_default2]
            box_renderer_animated speed=1
            rigid_body mass=50 friction=10 rolling=0.2
            box_renderer_rigid_directed
            behaviour_agent graph=enemy
            effects
            health max=50
            destroy_on_death
            character group=creep
        ]
        children=[
            entity name=Hitbox size=[0.5 0.5] components=[
                collider material=character
            ]
            entity name=HealthBar position=[0 0.3] size=[0.5 0.08] components=[
                health_bar layer=ui1 visibility_interval=5
            ]
        ]

    prefab name=Tree size=[3 3] components=[
        box_renderer layer=prop1 texture=[tree1 tree2 tree3 tree4 tree5]
        box_renderer_animated speed=1
    ]

    prefab name=NevermoreFearBall size=[0.5 0.5] components=[
        box_renderer layer=effect1 texture=[nevermore_arrow1 nevermore_arrow2 nevermore_arrow3]
        box_renderer_animated speed=2
        fear_ball speed=10 range=10 damage=5 effects=[fear duration=1]
        box_light texture=light1
    ] children = [
        entity name=Hitbox position=[0 0] size=[0.5 0.5] components=[
            collider layer=arrow
        ]
    ]

    prefab name=NevermoreArrow size=[0.75 0.75] components=[
            box_renderer layer=effect1 texture=[nevermore_arrow1 nevermore_arrow2 nevermore_arrow3]
            box_renderer_animated speed=2
            arrow
            arrow_damager
            box_light texture=light1
    ] children = [
        entity name=Hitbox position=[0 0] size=[0.75 0.75] components=[
            collider layer=arrow
        ]
    ]
]
