once name=menu_deps body=[
    /* Renderer layers */
    renderer_layer name=bg1 priority=1
    renderer_layer name=bg2 priority=2
    renderer_layer name=prop1 priority=10
    renderer_layer name=effect1 priority=30
    renderer_layer name=gizmo priority=255

    renderer_layer name=ui1 priority=101
    renderer_layer name=ui2 priority=102
    renderer_layer name=ui3 priority=103
    renderer_layer name=ui10 priority=104
    renderer_layer name=ui11 priority=105
    renderer_layer name=ui12 priority=106
    renderer_layer name=ui13 priority=107


    /* Textures */
    texture name=campfire1 tile=[384 384] count=16 path=textures/campfire1.png
    texture name=campfire2 tile=[384 384] count=16 path=textures/campfire2.png

    texture name=tree1 tile=[512 512] count=16 path=textures/tree1.png
    texture name=tree2 tile=[512 512] count=16 path=textures/tree2.png
    texture name=tree3 tile=[512 512] count=16 path=textures/tree3.png
    texture name=tree4 tile=[512 512] count=16 path=textures/tree4.png
    texture name=tree5 tile=[512 512] count=16 path=textures/tree5.png

    texture name=nevermore1 tile=[256 512] count=64 path=textures/nevermore1.png
    texture name=nevermore_arrow1 tile=[192 192] count=16 path=textures/nevermore_arrow1.png
    texture name=nevermore_arrow2 tile=[192 192] count=16 path=textures/nevermore_arrow2.png
    texture name=nevermore_arrow3 tile=[192 192] count=16 path=textures/nevermore_arrow3.png

    texture name=enemy_default1 tile=[192 192] count=16 path=textures/enemy_default1.png
    texture name=enemy_default2 tile=[192 192] count=16 path=textures/enemy_default2.png

    texture name=light1 tile=[512 512] path=textures/light1.png






    /* Fonts */
    font name=font1 path=fonts/jetbrains_mono.ttf size=40 loading_mode=lazy







    /* Clips */
    clip name=campfire1 path=sounds/campfire.ogg loading_mode=lazy storing_mode=compact
    clip name=nevermore_arrow1 path=sounds/nevermore_arrow1.wav loading_mode=lazy storing_mode=fast
    clip name=nevermore_fear_balls_cast path=sounds/nevermore_fear_balls_cast.wav loading_mode=lazy storing_mode=compact
    clip name=nevermore_fear_balls_invoke path=sounds/nevermore_fear_balls_invoke.wav loading_mode=lazy storing_mode=compact
    clip name=coins1 path=sounds/coins1.wav loading_mode=lazy storing_mode=fast
    clip name=footstep_ground1 path=sounds/footstep_ground1.wav loading_mode=lazy storing_mode=fast
    clip name=footstep_ground2 path=sounds/footstep_ground2.wav loading_mode=lazy storing_mode=fast
    clip name=footstep_ground3 path=sounds/footstep_ground3.wav loading_mode=lazy storing_mode=fast
    clip name=footstep_ground4 path=sounds/footstep_ground4.wav loading_mode=lazy storing_mode=fast
    clip name=footstep_water1 path=sounds/footstep_water1.wav loading_mode=lazy storing_mode=fast
    clip name=footstep_water2 path=sounds/footstep_water2.wav loading_mode=lazy storing_mode=fast
    clip name=footstep_water3 path=sounds/footstep_water3.wav loading_mode=lazy storing_mode=fast
    clip name=footstep_water4 path=sounds/footstep_water4.wav loading_mode=lazy storing_mode=fast
    clip name=footstep_water5 path=sounds/footstep_water5.wav loading_mode=lazy storing_mode=fast
    clip name=footstep_water6 path=sounds/footstep_water6.wav loading_mode=lazy storing_mode=fast
    clip name=footstep_water7 path=sounds/footstep_water7.wav loading_mode=lazy storing_mode=fast
    clip name=footstep_water8 path=sounds/footstep_water8.wav loading_mode=lazy storing_mode=fast
    clip name=footstep_water9 path=sounds/footstep_water9.wav loading_mode=lazy storing_mode=fast
    clip name=footstep_water10 path=sounds/footstep_water10.wav loading_mode=lazy storing_mode=fast
    clip name=footstep_water11 path=sounds/footstep_water11.wav loading_mode=lazy storing_mode=fast

    /* Sounds */
    sound name=campfire clips=[campfire1]
    sound name=nevermore_arrow clips=[nevermore_arrow1]
    sound name=nevermore_fear_balls_cast clips=[nevermore_fear_balls_cast]
    sound name=nevermore_fear_balls_invoke clips=[nevermore_fear_balls_invoke]
    sound name=coins clips=[coins1]
    sound name=footstep_ground clips=[footstep_ground1 footstep_ground2 footstep_ground3 footstep_ground4]
    sound name=footstep_water clips=[footstep_water1 footstep_water2 footstep_water3 footstep_water4 footstep_water5 footstep_water6 footstep_water7 footstep_water8 footstep_water9 footstep_water10 footstep_water11]
]
