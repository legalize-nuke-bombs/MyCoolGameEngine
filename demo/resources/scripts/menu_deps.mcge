    texture name=nevermore_arrow2 tile=[192 192] count=16 path=textures/nevermore_arrow2.png
    texture name=nevermore_arrow3 tile=[192 192] count=16 path=textures/nevermore_arrow3.png

    texture name=enemy_default1 tile=[192 192] count=16 path=textures/enemy_default1.png
    texture name=enemy_default2 tile=[192 192] count=16 path=textures/enemy_default2.png

