    texture name=tree3 tile=[512 512] count=16 path=textures/tree3.png
    texture name=tree4 tile=[512 512] count=16 path=textures/tree4.png
    texture name=tree5 tile=[512 512] count=16 path=textures/tree5.png

    texture name=nevermore1 tile=[256 512] count=64 path=textures/nevermore1.png
