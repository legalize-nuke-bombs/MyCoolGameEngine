eval path=scripts/map_deps.mcge

entity name=GameState components=[
    clock seconds=0 speed=3600
    sky day=[125 125 150 255] night=[40 40 70 255]
    scene_switcher key=Escape script=scripts/menu.mcge
]

entity name=Terrain size=[250 250] components=[
    box_renderer layer=bg1 color=[30 30 40 255]
    rigid_surface layer=bg1 material=ground
]

entity name=Forest size=[250 250] components=[
    forest count=2000 prefabs=[Tree]
]

entity name=Forest size=[250 250] components=[
    forest count=500 prefabs=[Enemy]
]

entity name=Campfire position=[4 2] size=[1.5 1.5]
    components=[
        box_renderer layer=prop1 texture=[campfire1 campfire2]
        box_renderer_animated speed=1
    ]
    children=[
        entity name=Light size=[6.5 6.5] components=[
            box_light texture=light1
            pulsator lower=0.99 upper=1.01 speed=10
        ]
        entity name=Collider position=[0 -0.25] size=[0.5 0.5] components=[
            collider material=ground
        ]
    ]

entity name=Character position=[2.5 1.5] size=[1.5 3]
    components=[
        box_renderer layer=prop1 texture=character
        box_renderer_animated speed=1
        rigid_body mass=250 friction=10 rolling=0.2
        box_renderer_rigid_directed
        movement speed=6.25
        keyboard_movement up=W down=S left=A right=D
        camera height=17.5
        simulator distance=50
        player
        mana max=800
        health max=1000
        hands
        skilled skills=[
            printer manacost=100 cooldown=1 execution_time=1 interruptable=1 title=Math.exe body=1000-7?
            fear_balls manacost=100 cooldown=1 execution_time=1 interruptable=0 prefab=FearBall count=50
        ]
    ]
    children=[
        entity name=Hitbox size=[0.45 0.6] components=[
            collider material=character
        ]
        entity name=HandsBar position=[-0.5 0.35] size=[1 0.04] components=[
            hands_bar layer1=ui1 layer2=ui2 color1=[10 10 10 255] color2=[255 0 0 255]
        ]
    ]
